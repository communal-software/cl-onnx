(in-package #:cl-onnx)

(defclass resource () ((pointer :initarg :pointer :accessor resource-pointer)))
(defclass session (resource)
  ((inputs :accessor session-inputs) (outputs :accessor session-outputs)))
(defclass tensor (resource) ())
(defclass run-options (resource) ())
(defstruct value-info name dtype shape)

(defun pointer (object)
  (or (resource-pointer object) (error 'onnx-error :message "Resource is closed")))

(defgeneric release (object))
(defmethod release ((object resource))
  (when (resource-pointer object)
    (etypecase object
      (session (%close (pointer object)))
      (tensor (%release (pointer object)))
      (run-options (%release-options (pointer object))))
    (setf (resource-pointer object) nil))
  nil)
(defmethod release ((object null)) nil)

(defun dtype-code (dtype)
  (ecase dtype (:f32 1) (:i32 6) (:i64 7)))
(defun code-dtype (code)
  (or (cdr (assoc code '((1 . :f32) (6 . :i32) (7 . :i64))))
      (error 'onnx-error :message (format nil "Unsupported tensor element type ~D" code))))
(defun foreign-type (dtype)
  (ecase dtype (:f32 :float) (:i32 :int32) (:i64 :int64)))

(defun session-info (session output)
  (cffi:with-foreign-objects ((count :size) (name :pointer) (dtype :int) (rank :size) (dims :int64 32))
    (check-status (%count (pointer session) output count))
    (loop for index below (cffi:mem-ref count :size)
          collect (progn
                    (check-status (%info (pointer session) output index name dtype rank dims 32))
                    (unwind-protect
                         (make-value-info :name (cffi:foreign-string-to-lisp (cffi:mem-ref name :pointer))
                                          :dtype (code-dtype (cffi:mem-ref dtype :int))
                                          :shape (loop for i below (cffi:mem-ref rank :size)
                                                       collect (cffi:mem-aref dims :int64 i)))
                      (%free-name (cffi:mem-ref name :pointer)))))))

(defun open-session (path &key (threads 1))
  (check-type threads (integer 1 2147483647))
  (let ((session (make-instance 'session :pointer (check-pointer (%open (namestring (pathname path)) threads))))
        (success nil))
    (unwind-protect
         (progn (setf (session-inputs session) (session-info session 0)
                      (session-outputs session) (session-info session 1)
                      success t)
                session)
      (unless success (release session)))))

(defmacro with-session ((name path &rest options) &body body)
  `(let ((,name (open-session ,path ,@options)))
     (unwind-protect (progn ,@body) (release ,name))))

(defun make-run-options () (make-instance 'run-options :pointer (check-pointer (%options))))
(defun terminate-run (options) (check-status (%terminate (pointer options))))
(defmacro with-run-options ((name) &body body)
  `(let ((,name (make-run-options))) (unwind-protect (progn ,@body) (release ,name))))

(defun tensor-properties (tensor)
  (cffi:with-foreign-objects ((dtype :int) (rank :size) (dims :int64 32))
    (check-status (%shape (pointer tensor) dtype rank dims 32))
    (values (code-dtype (cffi:mem-ref dtype :int))
            (loop for i below (cffi:mem-ref rank :size) collect (cffi:mem-aref dims :int64 i)))))
(defun tensor-dtype (tensor) (nth-value 0 (tensor-properties tensor)))
(defun tensor-shape (tensor) (nth-value 1 (tensor-properties tensor)))

(defun make-tensor (data shape &key (dtype :f32))
  (unless (and (listp shape) (<= (length shape) 32) (every (lambda (n) (typep n '(integer 0))) shape))
    (error 'onnx-error :message "Shape must contain at most 32 non-negative dimensions"))
  (let* ((size (reduce #'* shape :initial-value 1)) (type (foreign-type dtype))
         (values (and data (coerce data 'vector))))
    (when (and data (/= (length data) size))
      (error 'onnx-error :message "Tensor data length does not match shape"))
    (cffi:with-foreign-object (dims :int64 (max 1 (length shape)))
      (loop for n in shape for i from 0 do (setf (cffi:mem-aref dims :int64 i) n))
      (let ((tensor (make-instance 'tensor :pointer (check-pointer (%tensor (dtype-code dtype) dims (length shape)))))
            (success nil))
        (unwind-protect
             (progn
               (cffi:with-foreign-object (address :pointer)
                 (check-status (%data (pointer tensor) address))
                 (loop for i below size for value = (if values (aref values i) 0)
                       do (setf (cffi:mem-aref (cffi:mem-ref address :pointer) type i)
                                (if (eq dtype :f32) (coerce value 'single-float) value))))
               (setf success t)
               tensor)
          (unless success (release tensor)))))))

(defun tensor-data (tensor &key (start 0) end)
  (multiple-value-bind (dtype shape) (tensor-properties tensor)
    (let* ((size (reduce #'* shape :initial-value 1)) (end (or end size)))
      (unless (and (typep start '(integer 0)) (typep end '(integer 0)) (<= start end size))
        (error 'onnx-error :message "Tensor data range is outside its storage"))
      (cffi:with-foreign-object (address :pointer)
        (check-status (%data (pointer tensor) address))
        (let ((out (make-array (- end start)
                               :element-type (ecase dtype (:f32 'single-float) (:i32 '(signed-byte 32)) (:i64 '(signed-byte 64))))))
          (dotimes (i (length out) out)
            (setf (aref out i) (cffi:mem-aref (cffi:mem-ref address :pointer) (foreign-type dtype) (+ start i)))))))))

(defun run (session inputs &key options)
  "Return owned output tensors in an alist. INPUTS is an alist of names and borrowed tensors."
  (let* ((outputs (session-outputs session)) (count (length inputs))
         (out-count (length outputs)) (strings nil) (success nil))
    (unless (and (= count (length (session-inputs session)))
                 (= count (length (remove-duplicates inputs :key #'car :test #'equal)))
                 (every (lambda (info) (assoc (value-info-name info) inputs :test #'equal)) (session-inputs session)))
      (error 'onnx-error :message "Input names must match the session inputs exactly"))
    (cffi:with-foreign-objects ((names :pointer (max 1 count)) (values :pointer (max 1 count))
                               (out-names :pointer (max 1 out-count)) (out-values :pointer (max 1 out-count)))
      (dotimes (i out-count) (setf (cffi:mem-aref out-values :pointer i) (cffi:null-pointer)))
      (unwind-protect
           (progn
             (loop for (name . tensor) in inputs for i from 0
                   do (setf (cffi:mem-aref names :pointer i) (car (push (cffi:foreign-string-alloc name) strings))
                            (cffi:mem-aref values :pointer i) (pointer tensor)))
             (loop for info in outputs for i from 0
                   do (setf (cffi:mem-aref out-names :pointer i)
                            (car (push (cffi:foreign-string-alloc (value-info-name info)) strings))))
             (check-status (%run (pointer session) (if options (pointer options) (cffi:null-pointer))
                                 names values count out-names out-count out-values))
             (prog1 (loop for info in outputs for i from 0
                          collect (cons (value-info-name info)
                                        (make-instance 'tensor :pointer (cffi:mem-aref out-values :pointer i))))
               (setf success t)))
        (mapc #'cffi:foreign-string-free strings)
        (unless success
          (dotimes (i out-count)
            (unless (cffi:null-pointer-p (cffi:mem-aref out-values :pointer i))
              (%release (cffi:mem-aref out-values :pointer i)))))))))
